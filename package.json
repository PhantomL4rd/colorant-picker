{
  "name": "colorant-picker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:pages": "wrangler pages dev build --d1=DB --kv=KV --persist-to .wrangler/state",
    "build": "bun install --frozen-lockfile && vite build",
    "preview": "vite preview",
    "preview:pages": "bun run build && bun run dev:pages",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.7.1",
    "hono": "^4.13.10",
    "lucide-svelte": "^0.562.0",
    "lz-string": "^1.5.0",
    "mode-watcher": "^1.1.0",
    "sveltekit-i18n": "^2.4.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lz-string": "^1.5.0",
    "@biomejs/biome": "^2.5.14",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "undici": "^7.29.1"
  }
}
